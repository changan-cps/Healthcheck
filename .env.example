# ---------------------------------------------------------------
# CPS AI Audit runs on Google Apps Script. Production configuration
# lives in Apps Script "Script Properties" (Project Settings), NOT in
# this file. Never commit real values.
# ---------------------------------------------------------------

# --- Script Properties (set in Apps Script → Project Settings → Script Properties) ---
# ADMIN_INITIAL_PASSWORD=   # temporary admin password used once by setup(); deleted automatically
# AI_PROVIDER=gemini        # gemini | openai  (can also be set from the Settings page)
# AI_MODEL=gemini-2.5-flash
# GEMINI_TIER=free          # free | paid  (free tier: Google may use submitted data to improve services)
# GEMINI_API_KEY=           # set from the Settings page (write-only) or here
# OPENAI_API_KEY=
# DB_SPREADSHEET_ID=        # created automatically by setup()
# EVIDENCE_FOLDER_ID=       # created automatically by setup()

# --- Local development only (scripts/dev-server.mjs, tests) ---
CPS_STANDARD_DIR=./standards-local   # put the two standard .xlsx files here (git-ignored)
PORT=8787
LATENCY=120
